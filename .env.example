# Database Configuration
POSTGRES_HOST=etf-postgres
POSTGRES_PORT=5432
POSTGRES_DB=etfinsight
POSTGRES_USER=etfinsight
POSTGRES_PASSWORD=devpassword123

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# API Configuration
API_PORT=5001

# YFinance Configuration
# PERIOD: relative window used in scheduled mode (e.g. 5d, 1mo, 1y, 2y)
PERIOD=5d
# BACKFILL_FROM / BACKFILL_TO: set both to run a one-shot backfill then exit
# Leave empty for normal scheduled mode
BACKFILL_FROM=
BACKFILL_TO=

# Network Configuration
# Set NETWORK_INTERNAL=true to completely isolate from external networks
NETWORK_INTERNAL=false

# Scheduler Configuration
SCHEDULER_ENABLED=true
SCRAPER_INTERVAL_MINUTES=2
INGESTOR_INTERVAL_MINUTES=1

# Environment Configuration
ASPNETCORE_ENVIRONMENT=Development